git -C ~/work/ccs.ansible worktree add --detach .claude/worktrees/rdp-lang-validate 4ba90e0 && \
cd ~/work/ccs.ansible/.claude/worktrees/rdp-lang-validate && \
<validation commands named in the project's CLAUDE.md> </dev/null > "$SCRATCH/validate-4ba90e0.log" 2>&1
```

