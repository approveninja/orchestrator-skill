herdr agent read rdp-lang --source recent-unwrapped --lines 2000 > <inbox>/rdp-lang.transcript
grep -nF 'superpowers:' <inbox>/rdp-lang.transcript
grep -nE 'ansible-playbook|ssh |changed=' <inbox>/rdp-lang.transcript
